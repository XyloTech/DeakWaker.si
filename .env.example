OLLAMA_HOST=http://127.0.0.1:11434
MODEL=qwen3:latest
# THINKING: 0 = adaptive (deep thinking only after a failed step), 1 = think every step
THINKING=0
HEADLESS=0
USER_DATA_DIR=user_data
DOWNLOAD_DIR=downloads
SLOW_MO_MS=0
# BROWSER_CHANNEL: brave = installed Brave, system-chromium = installed Linux Chromium, none = bundled Chromium
BROWSER_CHANNEL=brave
# BROWSER_CHANNEL_ALTERNATIVES: comma-separated list of alternative browser channels to try if the primary channel fails
BROWSER_CHANNEL_ALTERNATIVES=
# Optional absolute Brave executable path, useful when Brave is installed in a custom location.
# BROWSER_EXECUTABLE=/usr/bin/brave-browser
# Optional: connect to a Brave window opened manually with remote debugging.
# BROWSER_CDP_URL=http://127.0.0.1:9222
# Never switch browsers silently. Set to 1 only when fallback is intentional.
BROWSER_ALLOW_FALLBACK=0
# AUTO_CONFIRM: 1 = agent auto-approves sensitive actions (default),
# 0 = ask y/N before logins, form submits, and purchases
AUTO_CONFIRM=1
# OLLAMA_TEMPERATURE: response sampling temperature (default 0.1)
OLLAMA_TEMPERATURE=0.1
# OLLAMA_NUM_CTX: context window size in tokens (default 4096)
OLLAMA_NUM_CTX=4096
# Keep prompts short for faster local inference; increase when tasks need more history.
MAX_HISTORY_STEPS=6
# Maximum interactive elements included in each Ollama prompt; indices remain stable.
OBSERVATION_ELEMENT_LIMIT=80
OBSERVATION_TEXT_LIMIT=1600
# OLLAMA_TIMEOUT_S: per-request Ollama timeout in seconds (default 300.0)
OLLAMA_TIMEOUT_S=300.0
