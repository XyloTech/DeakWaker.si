OLLAMA_HOST=http://127.0.0.1:11434
MODEL=qwen3:latest
# THINKING: 0 = adaptive (deep thinking only after a failed step), 1 = think every step
THINKING=0
HEADLESS=0
USER_DATA_DIR=user_data
DOWNLOAD_DIR=downloads
SLOW_MO_MS=100
# BROWSER_CHANNEL: chrome = your installed Google Chrome (default), none = bundled Chromium
BROWSER_CHANNEL=chrome
# AUTO_CONFIRM: 1 = agent auto-approves sensitive actions (default),
# 0 = ask y/N before logins, form submits, and purchases
AUTO_CONFIRM=1
# OLLAMA_TEMPERATURE: response sampling temperature (default 0.1)
OLLAMA_TEMPERATURE=0.1
# OLLAMA_NUM_CTX: context window size in tokens (default 4096)
OLLAMA_NUM_CTX=4096
# OLLAMA_TIMEOUT_S: per-request Ollama timeout in seconds (default 300.0)
OLLAMA_TIMEOUT_S=300.0
